@{
    ViewData["Title"] = "Email Sent";
    Layout = "~/Views/Shared/_AccountLayout.cshtml";
}

<div class="auth-page">
    <div class="auth-card">

        <!-- Logo -->
        <div class="auth-logo">
            <i class="ti ti-bowl-spoon"></i>
            <span>OneBite</span>
        </div>

        <!-- Heading -->
        <h1 class="auth-heading">Email Sent</h1>
        <p class="auth-sub">A confirmation link has been sent to your email. Please check your inbox and follow the instructions to activate your account.</p>

        <!-- Back to Login button -->
        <a asp-controller="Login" asp-action="Login" class="auth-submit" style="display:block; text-align:center; text-decoration:none;">Back to Login</a>

    </div>
</div>
